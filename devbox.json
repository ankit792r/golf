{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": [
    "go@latest",
    "raylib@latest"
  ],
  "env": {
    "GOPATH": "$DEVBOX_PROJECT_ROOT/.go",
    "PATH": "$GOPATH/bin:$PATH"
  },
  "shell": {
    "init_hook": [
      "alias dev='devbox'",
      "export PS1='📦 Golf > '"

    ],
    "scripts": {
      "export": [
        "bash scripts/export.sh"
      ]
    }
  }
}
